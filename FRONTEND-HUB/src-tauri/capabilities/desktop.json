{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Recursos locais da janela principal; SQLite e automacoes permanecem no backend.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "opener:allow-open-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/z3rdev"
        },
        {
          "url": "https://novelis.wtmh.com.br/portal/chamado/*"
        },
        {
          "url": "http://127.0.0.1:8000/*"
        },
        {
          "url": "http://localhost:8000/*"
        }
      ]
    },
    "fs:allow-write-file"
  ]
}
