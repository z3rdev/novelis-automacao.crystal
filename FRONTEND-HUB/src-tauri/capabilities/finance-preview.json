{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "finance-preview",
  "description": "Janela local de teste de mensagens do Financeiro em desenvolvimento.",
  "windows": ["finance-preview"],
  "remote": { "urls": ["http://127.0.0.1:1421/*"] },
  "permissions": [
    "core:default",
    "core:window:allow-set-theme",
    "dialog:allow-open",
    "dialog:allow-save",
    "fs:allow-write-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://novelis.wtmh.com.br/portal/chamado/*" }]
    }
  ]
}
