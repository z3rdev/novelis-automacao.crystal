PRE_USER=
PRE_PASS=
PREVIEW_AUTO_LOGIN=false
PRE_MANUAL_LOGIN=false
PRE_MANUAL_LOGIN_ONLY=false
PRE_DELLMAR_USER=
PRE_DELLMAR_PASS=
# true: etapa DELLMAR manual (botao, credenciais e grupo) | false: replay tenta automatizar
PRE_DELLMAR_MANUAL_LOGIN=false
PRE_DELLMAR_FIELD_X=390
PRE_DELLMAR_FIELD_Y=305

# Clique por posicao de mouse na tela seguinte ao login do PRE-PASSO
# Ajuste conforme sua necessidade.
# Se PRE_MOUSE_X e PRE_MOUSE_Y estiverem vazios, o script inicia o wizard de captura.
PRE_MOUSE_X=
PRE_MOUSE_Y=

# Captura de ponteiro na html5.html.
# true: ativa wizard step-by-step para nomear e capturar pontos.
# false: usa PRE_MOUSE_X/PRE_MOUSE_Y; se estiverem vazios, o wizard inicia automaticamente.
PRE_CAPTURE_POINTER=false
PRE_CAPTURE_FILE=captures/pre-pointer-map.json
PRE_REPLAY_FROM_CAPTURE=true
PRE_REPLAY_STEPS=3
PRE_REPLAY_CONTINUE_AFTER_TARIFARIO=true
PRE_REPLAY_CONTINUE_FROM_STEP=4
PRE_REPLAY_CONTINUE_STEPS=0
PRE_OVERWRITE_FLOW_ENABLED=true
PRE_OVERWRITE_TRIGGER_STEP=26
