PRE_DOCUMENTO_ROW_INDEX=0
PRE_DOCUMENTO_TYPE_DELAY_MS=100
PRE_CONSULTA_FILE=FONTE DE DADOS/CONSULTA.xlsx
PRE_CONSULTA_SHEET=CONSULTA NO BANCO
PRE_CONSULTA_START_ROW=2
PRE_CLICK_MAX_RETRIES=2
PRE_USE_IMAGE_TARGETING=false
PRE_USE_VISUAL_VALIDATION=false
PRE_VERIFY_TIMEOUT_MS=8000
PRE_VISUAL_MIN_DIFF_RATIO=0.02
PRE_STRICT_VIEWPORT=true
PRE_TEMPLATE_DIR=captures/templates
