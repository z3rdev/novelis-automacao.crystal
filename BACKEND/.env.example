PRE_OVERWRITE_FROM_CYCLE=2
PRE_WAIT_STABLE_BEFORE_STEP=false
PRE_REUSE_SESSION_FIRST=true
PRE_STEP_DELAY_MS=450
PRE_FILL_FILIAL_FROM_SHEET=true
PRE_FILIAL_STEP_NUMBER=9
PRE_FILIAL_STEP_LABEL=INPUT-FILIAL
PRE_FILIAL_ROW_INDEX=0
PRE_FILIAL_TYPE_DELAY_MS=100
PRE_FILL_DOCUMENTO_FROM_SHEET=true
